# European Options Application Environment Configuration

# Backend Environment
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security & CORS (Comma separated allowed origins or '*')
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Rate Limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_HEAVY=20/minute

# Frontend Environment (Vite)
VITE_API_URL=/api
